  },
  "capabilities": {
    "required": [],
    "recommended": [],
    "optional": []
  },
  "tools": {
    "allowed": [
      "ShipCheck",
      "Concord",
      "Tribunal",
      "CaseFile",
      "Scent",
      "Scout",
      "Fence",
      "Eval",
      "ChangeBucket",
      "Workcell"
    ]
  },
  "workflows": [],
  "inputs": [
    {
      "name": "goal_spec_diff_or_planned_change_target_repos_release_intent_risk_tolerance_and_existing_evidence",
      "description": "Goal, spec, diff or planned change, target repos, release intent, risk tolerance, and existing evidence."
