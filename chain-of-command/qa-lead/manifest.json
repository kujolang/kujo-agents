  },
  "capabilities": {
    "required": [],
    "recommended": [],
    "optional": []
  },
  "tools": {
    "allowed": [
      "RunLedger",
      "ShipCheck",
      "CaseFile",
      "Eval",
      "Lens",
      "Capsule",
      "Workcell"
