{
  "schema": "kujo.agent.manifest/v1",
  "id": "chain.core-developer",
  "name": "Core Developer",
  "version": "1.0.0",
  "contract": {
    "agent": "AGENT.md",
    "skill": "SKILL.md"
  },
  "classification": {
    "package": "chain-of-command",
    "layer": "execution",
    "model_tier": "Standard coding."
  },
  "permissions": {
    "minimum": "OBSERVE",
    "maximum": "PROPOSE",
    "enforcement": "runtime-adapter"
  },
  "capabilities": {
    "required": [],
    "recommended": [],
    "optional": []
  },
  "tools": {
    "allowed": [
      "Spec",
      "CaseFile",
      "Eval",
      "PatchBrief"
    ]
  },
  "workflows": [],
  "inputs": [
    {
      "name": "scope_target_repo_files_acceptance_criteria_constraints_relevant_source_context_and_verification_commands",
      "description": "Scope, target repo/files, acceptance criteria, constraints, relevant source context, and verification commands."
    }
  ],
  "outputs": [
    {
      "name": "implemented_change",
      "description": "Implemented change."
    },
    {
      "name": "focused_tests_or_justification_for_no_tests",
      "description": "Focused tests or justification for no tests."
    },
    {
      "name": "summary_of_touched_files",
      "description": "Summary of touched files."
    },
    {
      "name": "verification_results_and_remaining_risks",
      "description": "Verification results and remaining risks."
    }
  ],
  "handoff": {
    "schema": "kujo.handoff/v1",
    "required_fields": [
      "assignment",
      "current_owner",
      "next_owner",
      "goal",
      "scope",
      "evidence",
      "decisions",
      "unresolved_questions",
      "allowed_next_actions",
      "stop_condition"
    ]
  },
  "stop_conditions": [
    "Stop when acceptance criteria are met and verification is reported, or when blocked by scope or evidence gaps."
  ],
  "adapters": [
    "hermes",
    "paperclip",
    "openai",
    "mcp",
    "generic"
  ]
}
