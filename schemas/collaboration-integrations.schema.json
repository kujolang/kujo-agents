{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kujo:collaboration:compatibility:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "kujo.collaboration.compatibility/v1"},
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_ids", "platform", "host", "protocol_major", "status", "operations"],
        "properties": {
          "agent_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "platform": {"enum": ["local", "slack", "matrix", "teams", "paperclip", "board", "mcp"]},
          "host": {"type": "string", "pattern": "^[a-z0-9-]{1,60}$"},
          "protocol_major": {"const": 1},
          "status": {"enum": ["fixture-only", "experimental", "qualified"]},
          "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z.-]{1,48}$"}},
          "setup_url": {"type": "string", "pattern": "^https://(agents\\.kujolang\\.ai|github\\.com)/[A-Za-z0-9_./-]+$"},
          "qualification_url": {"type": "string", "pattern": "^https://(agents\\.kujolang\\.ai|github\\.com)/[A-Za-z0-9_./-]+$"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "qualified"}}},
            "then": {"required": ["setup_url", "qualification_url"]},
            "else": {"not": {"anyOf": [{"required": ["setup_url"]}, {"required": ["qualification_url"]}]}}
          }
        ]
      }
    }
  }
}
