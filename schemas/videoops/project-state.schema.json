{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_count": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "INTAKE_READY",
        "PLANNING",
        "PLANNING_READY",
        "ASSETING",
        "ASSETS_READY",
        "GENERATING",
        "PRODUCTION_READY",
        "EDITING",
        "DRAFT_READY",
        "REVIEWING",
        "REVISION_REQUIRED",
        "APPROVED",
        "FINAL_RENDERING",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "state",
    "run_id",
    "revision_count"
  ],
  "title": "VideoOps Project State",
  "type": "object"
}
