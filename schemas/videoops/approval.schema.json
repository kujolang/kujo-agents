{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "dimensions": {
      "additionalProperties": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
      },
      "type": "object"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_count": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "required": [
    "status",
    "revision_count",
    "dimensions"
  ],
  "title": "VideoOps Approval",
  "type": "object"
}
