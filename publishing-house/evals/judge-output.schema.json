{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kujolang.com/schemas/publishing-house-judge-output-v1.json",
  "title": "Publishing House Blind Quality Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "rubric_version",
    "preferred_candidate",
    "confidence",
    "decisive_dimensions",
    "candidates",
    "rationale"
  ],
  "properties": {
    "schema_version": { "const": "publishing-house-judge-output-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "rubric_version": { "const": "publishing-house-quality-rubric-v1" },
    "judge_id": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "preferred_candidate": { "enum": ["A", "B", "TIE"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "decisive_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/dimension" }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "$ref": "#/definitions/candidateJudgment" },
        "B": { "$ref": "#/definitions/candidateJudgment" }
      }
    },
    "rationale": { "type": "string", "minLength": 40 }
  },
  "definitions": {
    "dimension": {
      "enum": [
        "consequence",
        "distinctiveness",
        "insight",
        "defensibility",
        "craft",
        "brand_integrity",
        "format_fidelity",
        "strategic_purpose"
      ]
    },
    "rating": {
      "enum": ["EXCEPTIONAL", "STRONG", "ADEQUATE", "WEAK", "FAILED", "UNVERIFIED"]
    },
    "candidateJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "ratings", "blocking_failures", "generic_signals", "evidence"],
      "properties": {
        "classification": {
          "enum": ["PREMIUM", "STRONG_NOT_PREMIUM", "COMPETENT_GENERIC", "FAILED"]
        },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consequence",
            "distinctiveness",
            "insight",
            "defensibility",
            "craft",
            "brand_integrity",
            "format_fidelity",
            "strategic_purpose"
          ],
          "properties": {
            "consequence": { "$ref": "#/definitions/rating" },
            "distinctiveness": { "$ref": "#/definitions/rating" },
            "insight": { "$ref": "#/definitions/rating" },
            "defensibility": { "$ref": "#/definitions/rating" },
            "craft": { "$ref": "#/definitions/rating" },
            "brand_integrity": { "$ref": "#/definitions/rating" },
            "format_fidelity": { "$ref": "#/definitions/rating" },
            "strategic_purpose": { "$ref": "#/definitions/rating" }
          }
        },
        "blocking_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "generic_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
