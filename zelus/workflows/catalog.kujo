# Executable Kujo workflow registry.
#
# A workflow is data returned by Kujo functions, so the Director, Dispatch, or
# another runner can inspect the same contract without parsing JSON files.

func workflow(id, title, owner, steps) {
    return {"id": id, "title": title, "owner": owner, "steps": steps, "execution": "bounded-and-scope-gated", "evidence_required": true}
}

func step(id, agent, skill, requires, gate) {
    return {"id": id, "agent": agent, "skill": skill, "requires": requires, "gate": gate}
}

func list_workflows() {
    return [
        workflow("engagement-intake", "Engagement intake", "engagement-intelligence", [step("validate", "engagement-intelligence", "engagement_packet_ingest", [], "fail_closed"), step("compile-scope", "engagement-intelligence", "authorization_policy_compile", ["validate"], "fail_closed"), step("approve", "director", "campaign_plan_generate", ["compile-scope"], "human_review")]),
        workflow("campaign-planning", "Campaign planning", "director", [step("models", "director", "attacker_model_generate", [], "evidence_required"), step("plan", "director", "campaign_plan_generate", ["models"], "human_review"), step("tasks", "director", "task_package_generate", ["plan"], "fail_closed")]),
        workflow("wordpress-attack-surface", "WordPress attack surface mapping", "recon", [step("discover", "recon", "wordpress_instance_detect", [], "scope_gate"), step("inventory", "recon", "wordpress_component_inventory", ["discover"], "evidence_required"), step("correlate", "recon", "recon_signal_correlate", ["inventory"], "evidence_required")]),
        workflow("source-assisted-hunt", "Source-assisted vulnerability hunt", "wordpress-source", [step("hooks", "wordpress-source", "wordpress_hook_map", [], "evidence_required"), step("routes", "wordpress-source", "wordpress_rest_route_map", ["hooks"], "evidence_required"), step("flows", "wordpress-source", "wordpress_data_flow_trace", ["routes"], "evidence_required")]),
        workflow("version-patch-hunt", "Version and patch hunt", "wordpress-source", [step("diff", "wordpress-source", "wordpress_version_diff", [], "evidence_required"), step("intent", "wordpress-source", "wordpress_patch_intent_infer", ["diff"], "evidence_required"), step("bypass", "wordpress-source", "wordpress_patch_bypass_hunt", ["intent"], "evidence_required")]),
        workflow("role-matrix", "Role matrix campaign", "identity-authorization", [step("provision", "exploit-engineer", "wordpress_workcell_provision", [], "scope_gate"), step("replay", "identity-authorization", "role_matrix_replay", ["provision"], "evidence_required"), step("escalate", "identity-authorization", "wordpress_privilege_escalation_hunt", ["replay"], "evidence_required")]),
        workflow("exploit-development", "Controlled exploit development", "exploit-engineer", [step("cell", "exploit-engineer", "wordpress_workcell_provision", [], "scope_gate"), step("reproduce", "exploit-engineer", "hypothesis_reproduce", ["cell"], "approval_required"), step("primitive", "exploit-engineer", "primitive_record_create", ["reproduce"], "evidence_required")]),
        workflow("attack-chain-synthesis", "Attack-chain synthesis", "chain-architect", [step("graph", "chain-architect", "primitive_graph_update", [], "evidence_required"), step("compatibility", "chain-architect", "primitive_compatibility_analyze", ["graph"], "evidence_required"), step("reproduce", "chain-architect", "attack_chain_reproduce", ["compatibility"], "approval_required")]),
        workflow("independent-verification", "Independent verification", "verification", [step("rebuild", "verification", "independent_reproduction", [], "independent_context"), step("challenge", "verification", "false_positive_challenge", ["rebuild"], "evidence_required"), step("readiness", "verification", "severity_calibrate", ["challenge"], "human_review")]),
        workflow("responsible-disclosure", "Responsible disclosure", "case-officer", [step("casefile", "case-officer", "casefile_build", [], "verification_required"), step("redact", "case-officer", "evidence_redact", ["casefile"], "data_policy"), step("report", "case-officer", "vendor_report_render", ["redact"], "director_approval")]),
        workflow("campaign-postmortem", "Campaign postmortem", "case-officer", [step("review", "case-officer", "campaign_postmortem_generate", [], "campaign_closed"), step("knowledge", "case-officer", "campaign_postmortem_generate", ["review"], "sanitized_only")]),
        workflow("unauthenticated-surface", "Unauthenticated surface hunt", "recon", [step("surface", "recon", "authentication_surface_map", [], "scope_gate"), step("public", "wordpress-source", "wordpress_rest_route_map", ["surface"], "evidence_required"), step("reproduce", "exploit-engineer", "hypothesis_reproduce", ["public"], "approval_required")]),
        workflow("low-privilege-escalation", "Low-privilege escalation hunt", "identity-authorization", [step("roles", "identity-authorization", "wordpress_role_matrix_build", [], "scope_gate"), step("objects", "identity-authorization", "wordpress_object_authorization_test", ["roles"], "evidence_required"), step("impact", "chain-architect", "maximum_credible_impact_assess", ["objects"], "human_review")]),
        workflow("ai-wordpress-adversary", "AI and integration security campaign", "ai-integration", [step("surface", "ai-integration", "ai_feature_surface_map", [], "scope_gate"), step("authorization", "ai-integration", "ai_tool_authorization_review", ["surface"], "approval_required"), step("chain", "chain-architect", "attack_chain_generate", ["authorization"], "evidence_required")])
    ]
}

func list_workflow_ids() {
    ids := []
    for item in list_workflows() { ids = push(ids, item["id"]) }
    return ids
}

func get_workflow(id) {
    for item in list_workflows() { if item["id"] == id { return item } }
    return null
}

func validate_workflow(item) {
    errors := []
    if item == null || has_key(item, "id") == 0 { errors = push(errors, "workflow id is required") }
    if item == null || has_key(item, "steps") == 0 || len(item["steps"]) == 0 { errors = push(errors, "workflow steps are required") }
    if item != null && has_key(item, "steps") { for current in item["steps"] { if has_key(current, "agent") == 0 { errors = push(errors, "step agent is required") }; if has_key(current, "skill") == 0 { errors = push(errors, "step skill is required") } } }
    return {"valid": len(errors) == 0, "errors": errors}
}

export list_workflows := list_workflows
export list_workflow_ids := list_workflow_ids
export get_workflow := get_workflow
export validate_workflow := validate_workflow
