{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Zelus engagement packet",
  "type":"object",
  "required":["engagement_id","name","objective","authorization","targets"],
  "properties":{
    "engagement_id":{"type":"string"},
    "name":{"type":"string"},
    "objective":{"type":"string"},
    "authorization":{"type":"object","required":["mode","scope_rules"]},
    "targets":{"type":"array"},
    "products":{"type":"array"},
    "constraints":{"type":"array"}
  },
  "additionalProperties":true
}
