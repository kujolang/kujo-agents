from src.common import list_includes
from src.contracts import base_record, make_hypothesis, transition, validate_record
from src.policy import evaluate, wildcard_match
from src.reporting import validate_readiness
from src.graph import add_primitive, compatible, synthesize

mut passed := 0
mut failed := 0

func check(condition, name) {
    if condition == true { passed = passed + 1 } else { failed = failed + 1; print("FAIL: " + name) }
}

card := make_hypothesis("eng-test", "campaign-test", "fixture", "plugin.php", "update_option", "POST value", ["plugin.php:4"])
check(validate_record(card)["valid"] == true, "record envelope validates")
check(card["kind"] == "HypothesisCard", "hypothesis is not a finding")
check(card["status"] == "hypothesis", "hypothesis has explicit state")

profile := {"mode":"internal_simulation","scope_rules":[{"pattern":"fixture","decision":"allow","actions":["role_matrix_replay"],"environments":["workcell"]}],"prohibited_actions":["dos"],"required_approvals":{}}
check(evaluate(profile, "unknown", "role_matrix_replay", "workcell", false)["decision"] == "pending_scope", "unknown target is pending")
check(evaluate(profile, "fixture", "dos", "workcell", false)["decision"] == "prohibited", "prohibited action is denied")
check(evaluate(profile, "fixture", "role_matrix_replay", "workcell", false)["allowed"] == true, "approved action is allowed")

check(wildcard_match("*.example.com", "app.example.com") == true, "suffix wildcard matches")
check(wildcard_match("*.example.com", "example.net") == false, "unrelated host does not match")

record := base_record("FindingRecord", "eng-test", "campaign-test", "director")
record["status"] := "reproduced"
result := transition(record, "independently_verified", "verification", "clean reproduction", ["evidence-1"])
check(result["ok"] == true, "transition succeeds")
check(result["record"]["status"] == "independently_verified", "new state recorded")
check(list_includes(result["record"]["evidence_refs"], "evidence-1"), "evidence is attached")

finding := base_record("FindingRecord", "eng-test", "campaign-test", "exploit-engineer")
finding["status"] := "independently_verified"
finding["evidence_refs"] := ["evidence-1"]
verdict := base_record("VerificationVerdict", "eng-test", "campaign-test", "verification")
verdict["verdict"] := "approved"
check(validate_readiness(finding, verdict)["valid"] == true, "approved finding is reportable")
verdict["verdict"] := "rejected"
check(validate_readiness(finding, verdict)["valid"] == false, "rejected finding is not reportable")

left := {"id":"primitive-left", "attacker_before":"subscriber", "capability_gained":"modify option", "new_surfaces_unlocked":["administrator-influenced configuration"]}
right := {"id":"primitive-right", "attacker_before":"administrator-influenced configuration", "preconditions":["administrator-influenced configuration"], "capability_gained":"administrator-side execution"}
check(compatible(left, right) == true, "compatible primitives are recognized")
chain_graph := {"primitives": [], "revision": 0}
chain_graph = add_primitive(chain_graph, left)
chain_graph = add_primitive(chain_graph, right)
check(len(synthesize(chain_graph, "eng-test", "campaign-test")) == 1, "chain candidate is synthesized")

print("Zelus contract tests: " + to_string(passed) + " passed, " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
