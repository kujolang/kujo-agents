from src.common import ensure_parent, get_or, new_id, now_text, write_json

func remove_tree(path) {
    if path_is_dir(path) == false { if file_exists(path) { delete_file(path) }; return }
    for name in list_dir(path) {
        child := join_path(path, name)
        if path_is_dir(child) { remove_tree(child) } else if file_exists(child) { delete_file(child) }
    }
    os_rmdir(path)
}

func create(spec, root, engagement_id, campaign_id) {
    id := new_id("workcell")
    path := root + "/" + id
    ensure_parent(path + "/state.json")
    state := {"workcell_id": id, "kind": "Workcell", "engagement_id": engagement_id, "campaign_id": campaign_id, "created_at": now_text(), "status": "ready", "spec": spec, "users": get_or(spec, "users", []), "fixtures": get_or(spec, "fixtures", {}), "network": {"outbound_capture": true, "internet_access": "restricted"}, "snapshots": []}
    write_json(path + "/state.json", state)
    write_file(path + "/http-events.jsonl", "")
    return state
}

func snapshot(workcell, label) {
    snapshot := {"label": label, "at": now_text(), "users": get_or(workcell, "users", []), "fixtures": get_or(workcell, "fixtures", {})}
    workcell["snapshots"] = push(get_or(workcell, "snapshots", []), snapshot)
    return snapshot
}

func destroy(root, workcell_id) {
    path := root + "/" + workcell_id
    if path_is_dir(path) == false { return {"ok": false, "error": "workcell not found"} }
    remove_tree(path)
    return {"ok": true, "cleaned": workcell_id}
}

export create := create
export snapshot := snapshot
export destroy := destroy
