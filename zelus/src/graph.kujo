from src.common import get_or, list_includes, new_id, now_text

func add_primitive(graph, primitive) {
    graph["primitives"] = push(get_or(graph, "primitives", []), primitive)
    graph["revision"] = get_or(graph, "revision", 0) + 1
    return graph
}

func compatible(left, right) {
    unlocks := get_or(left, "new_surfaces_unlocked", [])
    unlocks = push(unlocks, get_or(left, "capability_gained", ""))
    needs := get_or(right, "preconditions", [])
    needs = push(needs, get_or(right, "attacker_before", ""))
    for item in needs { if item != "" && list_includes(unlocks, item) { return true } }
    return false
}

func synthesize(graph, engagement_id, campaign_id) {
    chains := []
    primitives := get_or(graph, "primitives", [])
    for left in primitives {
        for right in primitives {
            if left["id"] == right["id"] { continue }
            if compatible(left, right) {
                chains = push(chains, {"id": new_id("chain"), "kind": "ChainRecord", "engagement_id": engagement_id, "campaign_id": campaign_id, "created_at": now_text(), "updated_at": now_text(), "creator": "chain-architect", "provenance": [left["id"], right["id"]], "confidence": "medium", "evidence_refs": [], "status": "chain_candidate", "tags": ["chain"], "schema_version": "zelus.v1", "primitive_ids": [left["id"], right["id"]], "starting_access": get_or(left, "attacker_before", "unknown"), "target_capability": get_or(right, "capability_gained", "unknown"), "compatibility": "technically_compatible", "reproduced": false, "live_validated": false, "impact": get_or(left, "capability_gained", "") + " -> " + get_or(right, "capability_gained", ""), "limitations": ["requires same identity, state, and configuration"]})
            }
        }
    }
    return chains
}

export add_primitive := add_primitive
export compatible := compatible
export synthesize := synthesize
