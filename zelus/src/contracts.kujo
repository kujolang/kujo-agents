from src.common import SCHEMA_VERSION, get_or, list_includes, new_id, now_text

REQUIRED_RECORD_FIELDS := ["id", "kind", "engagement_id", "created_at", "updated_at", "creator", "provenance", "confidence", "evidence_refs", "status", "tags", "schema_version"]
FINDING_STATUSES := ["signal", "candidate", "hypothesis", "triaged", "reproduced", "primitive_confirmed", "chain_candidate", "independently_verified", "reportable", "submitted", "vendor_acknowledged", "patched", "fix_verified", "closed", "disproved", "duplicate", "out_of_scope", "environment_dependent", "not_exploitable", "insufficient_evidence", "deferred"]

func base_record(kind, engagement_id, campaign_id, creator) {
    return {
        "id": new_id(lower(kind)),
        "kind": kind,
        "engagement_id": engagement_id,
        "campaign_id": campaign_id,
        "created_at": now_text(),
        "updated_at": now_text(),
        "creator": creator,
        "provenance": [],
        "confidence": "medium",
        "evidence_refs": [],
        "status": "draft",
        "tags": [],
        "schema_version": SCHEMA_VERSION
    }
}

func validate_record(record) {
    errors := []
    for field in REQUIRED_RECORD_FIELDS {
        if has_key(record, field) == 0 { errors = push(errors, "missing " + field) }
    }
    if has_key(record, "confidence") && (record["confidence"] != "low" && record["confidence"] != "medium" && record["confidence"] != "high") { errors = push(errors, "invalid confidence") }
    if has_key(record, "schema_version") && record["schema_version"] != SCHEMA_VERSION { errors = push(errors, "unsupported schema version") }
    return {"valid": len(errors) == 0, "errors": errors}
}

func transition(record, next_status, actor, reason, evidence) {
    if has_key(record, "status") == 0 { return {"ok": false, "error": "record has no status"} }
    if has_key(record, "kind") && record["kind"] == "FindingRecord" && list_includes(FINDING_STATUSES, next_status) == false { return {"ok": false, "error": "invalid finding state: " + next_status} }
    previous := record["status"]
    record["status"] := next_status
    record["updated_at"] := now_text()
    for ref in evidence { if list_includes(record["evidence_refs"], ref) == false { record["evidence_refs"] = push(record["evidence_refs"], ref) } }
    return {"ok": true, "record": record, "event": {"event_id": new_id("evt"), "event_type": "state_transition", "record_id": record["id"], "from": previous, "to": next_status, "actor": actor, "reason": reason, "evidence_refs": evidence, "occurred_at": now_text()}}
}

func make_task(engagement_id, campaign_id, agent, title, objective, attacker_model, assets) {
    task := base_record("TaskPackage", engagement_id, campaign_id, "director")
    task["task_id"] := new_id("task")
    task["assigned_agent"] := agent
    task["title"] := title
    task["objective"] := objective
    task["why_this_matters"] := "This lane tests a distinct adversarial trust boundary and can unlock validated follow-up work."
    task["attacker_model"] := attacker_model
    task["starting_access"] := "unauthenticated or low-privilege account"
    task["target_assets"] := assets
    task["assumptions_to_challenge"] := ["authorization is enforced at every entry point", "nonce presence is not authorization", "discovered assets are not automatically in scope"]
    task["authorized_actions"] := ["read supplied source", "use synthetic Workcells", "capture evidence"]
    task["prohibited_actions"] := ["out-of-scope targets", "real user data", "denial of service", "persistence"]
    task["required_evidence"] := ["raw tool receipt", "reproduction package", "cleanup proof"]
    task["expected_outputs"] := ["HypothesisCard", "TaskResult", "EvidenceReference"]
    task["handoff_targets"] := ["director", "verification"]
    task["escalation_conditions"] := ["scope ambiguity", "privileged live impact", "cleanup failure"]
    task["stop_conditions"] := ["authorization denied", "hypothesis disproved", "evidence unavailable"]
    task["priority"] := 20
    task["deadline_or_budget"] := "bounded local run"
    task["status"] := "queued"
    return task
}

func make_hypothesis(engagement_id, campaign_id, target, component, sink, source, evidence) {
    card := base_record("HypothesisCard", engagement_id, campaign_id, "wordpress-source")
    card["hypothesis_id"] := new_id("hypothesis")
    card["title"] := "Attacker-controlled input reaches a sensitive WordPress operation without an explicit capability boundary"
    card["target"] := target
    card["component"] := component
    card["versions"] := []
    card["vulnerability_class"] := "CWE-862 Missing Authorization"
    card["attacker_model"] := "low-privilege WordPress user"
    card["required_access"] := "authenticated subscriber or customer"
    card["entry_point"] := component
    card["attacker_controlled_input"] := source
    card["suspected_security_boundary"] := "WordPress capability and object authorization"
    card["sensitive_operation"] := sink
    card["missing_or_questionable_control"] := "No explicit current_user_can check observed in the candidate path"
    card["expected_behavior"] := "Reject the operation unless the principal holds the required capability and owns the object"
    card["observed_or_suspected_behavior"] := "Static analysis found a plausible source-to-sink path"
    card["potential_impact"] := "Protected state modification or data access"
    card["chain_potential"] := ["configuration modification", "administrator-side influence"]
    card["environmental_assumptions"] := ["component is enabled", "entry point is reachable", "role is not administrator"]
    card["static_evidence"] := evidence
    card["runtime_evidence"] := []
    card["duplicate_search_status"] := "not_started"
    card["program_eligibility"] := "requires policy evaluation"
    card["recommended_next_action"] := "Run a role matrix in a synthetic Workcell"
    card["required_agent"] := "identity-authorization"
    card["approval_level"] := "director"
    card["stop_conditions"] := ["no attacker control", "sink unreachable", "authorization denied"]
    card["status"] := "hypothesis"
    return card
}

export base_record := base_record
export validate_record := validate_record
export transition := transition
export make_task := make_task
export make_hypothesis := make_hypothesis
export REQUIRED_RECORD_FIELDS := REQUIRED_RECORD_FIELDS
export FINDING_STATUSES := FINDING_STATUSES
