func ensure_dir(path) {
    if !path_is_dir(path) {
        result := spawn_process(["mkdir", "-p", path], {"timeout_ms": 5000})
        if result.exitcode != 0 { panic("cannot create directory: " + path) }
    }
}

func write_text(path, value) { write_file_atomic(path, value, true) }
func write_json(path, value) { write_text(path, to_json_pretty(value) + "\n") }

func role_rows() {
    return [
        {
            "slug":"creative-director", "name":"Video Creative Director", "layer":"Planning", "profile":"economical-general",
            "purpose":"Transform validated PackWrite intake into a complete timed production plan without acquiring assets or rendering media.",
            "minimum":"PROPOSE", "maximum":"PROPOSE",
            "required":["filesystem","structured-output","long-context"], "recommended":["repository"], "optional":["web-research"],
            "tools":["PackWrite","Spec","Eval","RunLedger"],
            "skills":["videoops-video-brief-synthesis","videoops-transcript-and-onscreen-copy","videoops-shot-planning","videoops-visual-reference-decomposition","videoops-asset-requirement-specification","videoops-platform-duration-planning"],
            "workflows":["videoops-creative-planning"],
