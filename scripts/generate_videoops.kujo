        },
        {
            "slug":"media-generator", "name":"Video Media Generator", "layer":"Asseting", "profile":"economical-general",
            "purpose":"Create only the smallest set of custom media explicitly marked GENERATE and register each result in the asset manifest.",
            "minimum":"PROPOSE", "maximum":"ACT",
            "required":["filesystem","media-generation","media-inspection"], "recommended":["image-understanding"], "optional":["video-generation","ffmpeg"],
            "tools":["Image Generation","Video Generation","FFmpeg","RunLedger"],
            "skills":["videoops-generated-still-production","videoops-generated-motion-production","videoops-brand-style-translation","videoops-shot-context-generation","videoops-generation-variant-selection","videoops-generated-asset-manifesting"],
            "workflows":["videoops-media-generation"],
            "inputs":["planning/shot-list.json","planning/style-plan.md","assets/asset-manifest.json"],
            "outputs":["assets/generated/","assets/asset-manifest.json"],
