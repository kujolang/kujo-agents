            "required":["filesystem","repository","media-inspection"], "recommended":["browser-capture","web-research"], "optional":["media-download"],
            "tools":["Lens","FFmpeg","RunLedger"],
            "skills":["videoops-first-party-asset-discovery","videoops-lens-product-capture","videoops-licensed-media-research","videoops-asset-rights-triage","videoops-media-normalization","videoops-asset-manifest-maintenance","videoops-generation-handoff"],
