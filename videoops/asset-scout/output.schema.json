{
  "$id": "https://kujolang.dev/schemas/videoops.asset-scout/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "handoff": {
      "$ref": "../../schemas/videoops/handoff.schema.json"
    },
    "model_profile": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "revision_required"
      ]
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "stage": {
      "const": "asset-scout"
    }
  },
  "required": [
    "run_id",
    "stage",
    "outcome",
    "artifacts",
    "evidence",
    "handoff"
  ],
  "title": "Video Asset Scout Output",
  "type": "object"
}
