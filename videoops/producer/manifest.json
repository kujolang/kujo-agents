{
  "adapters": [
    "hermes",
    "paperclip",
    "openai",
    "mcp",
    "generic"
  ],
  "capabilities": {
    "optional": [
      "browser-capture",
      "web-research",
      "media-generation"
    ],
    "recommended": [
      "repository",
      "media-inspection",
      "multimodal"
    ],
    "required": [
      "filesystem",
      "structured-output",
      "long-context"
    ]
  },
  "classification": {
    "layer": "Orchestration",
    "model_tier": "economical-first",
    "package": "videoops"
  },
  "contract": {
    "agent": "AGENT.md",
    "skill": "SKILL.md"
  },
  "handoff": {
    "required_fields": [
      "assignment",
      "current_owner",
      "next_owner",
      "goal",
      "scope",
      "artifacts",
      "evidence",
      "decisions",
      "unresolved_questions",
      "allowed_next_actions",
      "stop_condition"
    ],
    "schema": "kujo.handoff/v1"
  },
  "id": "videoops.producer",
  "inputs": [
    "user production request or validated PackWrite intake",
    "target workspace",
    "source materials and references",
    "approval, publication, and cost constraints"
  ],
  "model_policy": {
    "default_profile": "standard-reasoning",
    "max_economical_attempts": 2,
    "observable": true,
    "provider_binding": null,
    "stage_local_escalation": true
  },
  "name": "VideoOps Producer",
  "outputs": [
    "intake/",
    "planning/",
    "assets/",
    "production/",
    "review/",
    "output/final.mp4",
    "output/metadata.json",
    "review/production-summary.md"
  ],
  "permissions": {
    "enforcement": "runtime-adapter",
    "maximum": "ACT",
    "minimum": "PROPOSE"
  },
  "schema": "kujo.agent.manifest/v1",
  "skills": [
    "kujo-videoops-workflows"
  ],
  "stop_conditions": [
    "Stop only when the independent Critic passes the exact final candidate and final render evidence is complete, or when a recorded blocker requires operator action."
  ],
  "tools": {
    "allowed": [
      "PackWrite",
      "Dispatch",
      "RunLedger",
      "HyperFrames",
      "FFmpeg",
      "Eval",
      "Lens"
    ]
  },
  "version": "1.0.0",
  "workflows": [
    "videoops-production",
    "videoops-creative-planning",
    "videoops-asset-resolution",
    "videoops-media-generation",
    "videoops-hyperframes-edit",
    "videoops-quality-review"
  ]
}
