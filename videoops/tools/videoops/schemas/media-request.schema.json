{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/contracts/videoops/media-request/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "videoops-media-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "shot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
      },
      "maxItems": 10000
    },
    "capability": {
      "enum": [
        "speech",
        "sound_effects",
        "music",
        "transcription",
        "alignment",
        "catalog",
        "local_import"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "voice": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "similarity_boost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.2
        },
        "use_speaker_boost": {
          "type": "boolean"
        },
        "prompt_influence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "force_instrumental": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_duration_seconds": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "output_format": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "alignment": {
      "enum": [
        "required",
        "optional",
        "none"
      ]
    },
    "authorization_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_credits": {
          "type": "number",
          "minimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "enum": [
            "USD"
          ]
        },
        "estimate_evidence": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_credits",
        "max_cost",
        "currency",
        "estimate_evidence"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rights": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 10000
        },
        "intended_use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "evidence",
        "license",
        "attribution",
        "restrictions",
        "intended_use"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "request_id",
    "job_id",
    "asset_id",
    "requirement_id",
    "shot_ids",
    "capability",
    "provider",
    "model",
    "voice",
    "settings",
    "input",
    "language",
    "target_duration_seconds",
    "output_format",
    "alignment",
    "authorization_id",
    "budget",
    "attempt",
    "retry_of",
    "rights"
  ],
  "additionalProperties": false
}
